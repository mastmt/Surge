[Script]
xueqiu = type=http-response, pattern=^https?:\/\/api\.xueqiu\.com\/analysis\/home\/my_tab\.json, requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/WesleyRhodes/Script/main/js/xueqiu.js
